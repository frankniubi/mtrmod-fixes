{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"javaImplements": [
		"SerializedDataBase"
	],
	"properties": {
		"webserverPort": {
			"type": "integer",
			"default": 8888
		},
		"routeTextureAssetsEnabled": {
			"type": "boolean",
			"default": true
		},
		"routeTexturePublicBaseUrl": {
			"type": "string"
		},
		"routeTextureOutputDirectory": {
			"type": "string",
			"default": "route-textures"
		},
		"routeTextureGenerationThreads": {
			"type": "integer",
			"default": 1
		},
		"routeTextureRetainedRevisions": {
			"type": "integer",
			"default": 32
		},
		"routeTextureStaleAssetDays": {
			"type": "integer",
			"default": 7
		},
		"useThreadedSimulation": {
			"type": "boolean"
		},
		"useThreadedFileLoading": {
			"type": "boolean"
		},
		"forceShutDownStrayThreads": {
			"type": "boolean"
		}
	}
}
